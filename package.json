{
  "name": "dsh-purge",
  "version": "1.1.72",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Jailbreak for every model — swap prompts per model. 求 Star 收藏 ⭐ 如要二开，请查看署名要求部分",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "LICENSE-COMMERCIAL.md"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "extract-prompt": "node scripts/extract-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check": "node --check lib/index.js && node --check lib/core.js && node --check lib/rewind.js && node --check lib/skills.js && node --check bin/dsh-purge.js && node --check client.js",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run check && npm test"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37-oss/dsh-purge.git"
  },
  "upstream": {
    "url": "https://github.com/YuJunZhiXue/dsh-purge",
    "note": "原作者 小杨 (YuJunZhiXue)。本仓库是自维护 fork，署名与许可证沿用上游。"
  },
  "homepage": "https://github.com/37-oss/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/37-oss/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/37-oss/dsh-purge/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/37-oss/dsh-purge/archive/refs/heads/master.zip",
      "git": "https://github.com/37-oss/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.0-rc.2"
}
